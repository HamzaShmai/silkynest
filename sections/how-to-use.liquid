<section class="section" id="how-to-use">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section__title section__title--center">{{ section.settings.heading }}</h2>
      <p class="section__lead section__lead--center">{{ section.settings.lead }}</p>
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <article class="step reveal" {{ block.shopify_attributes }}>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          <p class="step__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="section__lead section__lead--center reveal" style="margin-top: 2.5rem; max-width: 48ch;">
        {{ section.settings.note }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How to use",
  "tag": "section",
  "class": "section-how-to-use",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use Silky Nest"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "A simple weekly ritual for softer, stronger, healthier-looking hair."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Bottom note",
      "default": "For best results, use 2–3 times a week. Suitable for all hair types."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Warm & apply"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Massage a small amount into your scalp using your fingertips."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Massage in",
            "text": "Warm a small amount of Silky Nest Hair Oil between your palms and massage into the scalp with gentle circular motions."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Let it nourish",
            "text": "Leave it on for at least 1–2 hours, or overnight for deeper nourishment and restoration."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Rinse & glow",
            "text": "Wash out with a mild shampoo. Repeat 2–3 times a week for softer, stronger, shinier hair."
          }
        }
      ]
    }
  ]
}
{% endschema %}
