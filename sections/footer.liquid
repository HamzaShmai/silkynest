<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <div class="site-footer__brand">{{ section.settings.brand | default: shop.name }}</div>
        <p class="site-footer__about">{{ section.settings.about }}</p>
      </div>

      <div>
        <h3 class="site-footer__heading">Explore</h3>
        <div class="site-footer__links">
          <a href="#shop">Shop</a>
          <a href="#benefits">Benefits</a>
          <a href="#how-to-use">How to Use</a>
          <a href="#reviews">Reviews</a>
          <a href="#faq">FAQ</a>
        </div>
      </div>

      <div>
        <h3 class="site-footer__heading">Support</h3>
        <div class="site-footer__links">
          {%- if section.settings.contact_email != blank -%}
            <a href="mailto:{{ section.settings.contact_email }}">Email Us</a>
          {%- endif -%}
          <a href="/policies/shipping-policy">Shipping</a>
          <a href="/policies/refund-policy">Returns</a>
          <a href="/policies/privacy-policy">Privacy</a>
          <a href="/policies/terms-of-service">Terms</a>
        </div>
      </div>

      <div>
        <h3 class="site-footer__heading">Promise</h3>
        <div class="site-footer__links">
          <span>Natural ingredients</span>
          <span>Cash on Delivery</span>
          <span>Secure checkout</span>
          <span>Made for all hair types</span>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="social-links">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M14 9h3V6h-3c-2 0-3 1-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M14 4c.6 2.4 2.2 4 4.8 4.4V11c-1.7-.1-3.2-.7-4.3-1.6v6.2A5.6 5.6 0 118.9 10c.5 0 1 .1 1.5.2v2.8a2.8 2.8 0 00-.9-.1 2.8 2.8 0 00.1 5.6A2.8 2.8 0 0014 15.7V4z" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "Silky Nest"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About",
      "default": "Silky Nest Hair Oil — a luxurious natural ritual crafted to nourish the scalp, reduce hair fall, and restore soft, luminous shine."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email"
    }
  ]
}
{% endschema %}
