<section class="newsletter" id="newsletter">
  <div class="container">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    <p class="section__lead">{{ section.settings.lead }}</p>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Email</label>
      <input
        id="NewsletterEmail-{{ section.id }}"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocomplete="email"
      >
      <button type="submit" class="btn btn--gold">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p style="margin-top: 0.75rem; width: 100%; color: var(--color-gold);">{{ section.settings.success_message }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay Close"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the nest"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Be first to know about restocks, rituals, and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for joining Silky Nest."
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
