{%- liquid
  assign product = section.settings.product
  if product == blank and settings.featured_product != blank
    assign product = settings.featured_product
  endif
  if product == blank
    assign product = all_products['silky-nest-hair-oil-your-hairs-secret-treasure']
  endif
  if product == blank
    assign product = collections.all.products.first
  endif

  assign current_variant = nil
  assign compare_at = 0
  assign price = 0
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    assign compare_at = current_variant.compare_at_price
    assign price = current_variant.price
  endif
-%}

<section class="section" id="shop" data-featured-product>
  <div class="container">
    <div class="section__header reveal">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section__title">{{ section.settings.heading }}</h2>
      <p class="section__lead">{{ section.settings.lead }}</p>
    </div>

    <div class="featured-product reveal" data-product-form-anchor>
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__main">
          {%- if product and product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="800"
              height="800"
              data-gallery-main
              loading="eager"
            >
          {%- else -%}
            <img
              src="{{ 'silky-nest-product-real.png' | asset_url }}"
              alt="Silky Nest Hair Oil"
              width="800"
              height="800"
              data-gallery-main
              loading="eager"
            >
          {%- endif -%}
        </div>

        <div class="product-gallery__thumbs">
          {%- if product and product.media.size > 0 -%}
            {%- for media in product.media limit: 4 -%}
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallbacks = 'silky-nest-product-real.png,silky-nest-box-real.png,silky-nest-benefits-side.jpg,image-4.jpg' | split: ',' -%}
            {%- assign labels = 'Product,Box,Benefits,Banner' | split: ',' -%}
            {%- for asset in fallbacks -%}
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-full="{{ asset | asset_url }}"
                data-alt="Silky Nest Hair Oil {{ labels[forloop.index0] }}"
                aria-label="View {{ labels[forloop.index0] }} image"
              >
                <img src="{{ asset | asset_url }}" alt="" width="120" height="120" loading="lazy">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <div class="product-info">
        {%- if compare_at > price and price > 0 -%}
          <div class="product-info__badge">Limited Offer · Save {{ compare_at | minus: price | money_without_trailing_zeros }}</div>
        {%- else -%}
          <div class="product-info__badge">100ml · Natural Formula</div>
        {%- endif -%}

        <h3 class="product-info__title">
          {%- if product -%}
            {{ product.title }}
          {%- else -%}
            Silky Nest Hair Oil – Your Hair's Secret Treasure
          {%- endif -%}
        </h3>

        <div class="product-info__rating">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>Loved across Pakistan</span>
        </div>

        <div class="product-info__price">
          {%- if product -%}
            <span class="product-info__price-current">{{ price | money }}</span>
            {%- if compare_at > price -%}
              <span class="product-info__price-compare">{{ compare_at | money }}</span>
              <span class="product-info__save">Sale</span>
            {%- endif -%}
          {%- else -%}
            <span class="product-info__price-current">Rs.1,500</span>
            <span class="product-info__price-compare">Rs.2,200</span>
            <span class="product-info__save">Sale</span>
          {%- endif -%}
        </div>

        <p class="product-info__desc">
          {%- if section.settings.description != blank -%}
            {{ section.settings.description }}
          {%- elsif product and product.description != blank -%}
            {{ product.description | strip_html | truncate: 220 }}
          {%- else -%}
            A luxurious blend of natural and organic herbs, seeds, and oils carefully crafted to transform your hair from roots to tips — reducing fall, restoring shine, and deeply nourishing every strand.
          {%- endif -%}
        </p>

        <ul class="product-benefits-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M5 9.2l2.4 2.4L13 6.2" stroke="currentColor" stroke-width="1.4"/></svg>
            <span><strong>Stimulates Growth</strong> — Nourishes follicles for stronger, healthier hair</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M5 9.2l2.4 2.4L13 6.2" stroke="currentColor" stroke-width="1.4"/></svg>
            <span><strong>Reduces Hair Fall</strong> — Fortifies strands and minimizes breakage</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M5 9.2l2.4 2.4L13 6.2" stroke="currentColor" stroke-width="1.4"/></svg>
            <span><strong>Adds Radiance</strong> — Leaves hair visibly glossy and soft</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/><path d="M5 9.2l2.4 2.4L13 6.2" stroke="currentColor" stroke-width="1.4"/></svg>
            <span><strong>Non-Sticky Formula</strong> — Absorbs beautifully without heavy residue</span>
          </li>
        </ul>

        {%- if product != blank -%}
          {%- form 'product', product, data-product-form: true, class: 'product-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">

            <div class="qty-selector" data-qty>
              <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>

            <div class="product-form__actions">
              <button
                type="submit"
                class="btn btn--gold"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available -%}
                  Add to Cart
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>
              <button
                type="submit"
                class="btn btn--dark"
                data-buy-now
                {% unless current_variant.available %}disabled{% endunless %}
              >
                Buy Now
              </button>
            </div>
          {%- endform -%}
        {%- else -%}
          <div class="product-form">
            <div class="qty-selector" data-qty>
              <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
            <div class="product-form__actions">
              <a href="#shop" class="btn btn--gold">Add to Cart</a>
              <a href="#shop" class="btn btn--dark">Buy Now</a>
            </div>
          </div>
        {%- endif -%}

        <div class="product-trust">
          <div class="product-trust__item">
            <strong>Cash on Delivery</strong>
            All over Pakistan
          </div>
          <div class="product-trust__item">
            <strong>Secure Checkout</strong>
            Encrypted & protected
          </div>
          <div class="product-trust__item">
            <strong>Satisfaction</strong>
            Support that cares
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One ritual. Transformed hair."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "Silky Nest Hair Oil is our signature formula — a single, focused product designed for deeper nourishment and lasting shine."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Product description override"
    }
  ],
  "presets": [
    { "name": "Featured product" }
  ]
}
{% endschema %}
