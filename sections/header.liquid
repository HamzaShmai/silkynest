<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <nav class="site-header__nav" aria-label="Primary">
      <a href="#shop">Shop</a>
      <a href="#categories">Benefits</a>
      <a href="#how-to-use">How to Use</a>
      <a href="#reviews">Reviews</a>
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 280 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">Silky Nest</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <button type="button" class="icon-btn mobile-nav-toggle" data-nav-toggle aria-expanded="false" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
      <button type="button" class="icon-btn" data-cart-open aria-label="Open cart">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 5h1.2l1.1 8.2a1 1 0 0 0 1 .8h6.9a1 1 0 0 0 1-.8L16.4 7H6.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="8.2" cy="16.2" r="1" fill="currentColor"/>
          <circle cx="14.2" cy="16.2" r="1" fill="currentColor"/>
        </svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    <a href="#shop">Shop</a>
    <a href="#categories">Benefits</a>
    <a href="#how-to-use">How to Use</a>
    <a href="#reviews">Reviews</a>
    <a href="#faq">FAQ</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (optional)"
    }
  ]
}
{% endschema %}
