<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.SilkyNest = window.SilkyNest || {};
      window.SilkyNest.moneyFormat = {{ shop.money_format | json }};
      window.SilkyNest.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_url: '{{ routes.cart_url }}',
        root: '{{ routes.root_url }}'
      };
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'sticky-atc' %}

    <div class="cart-drawer-overlay" data-cart-overlay hidden></div>
    <aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="Cart">
      <div class="cart-drawer__header">
        <h2 class="cart-drawer__title">Your Bag</h2>
        <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      <div class="cart-drawer__body" data-cart-body>
        <p class="cart-drawer__empty">Your bag is empty.</p>
      </div>
      <div class="cart-drawer__footer" data-cart-footer hidden>
        <div class="cart-drawer__subtotal">
          <span>Subtotal</span>
          <span data-cart-subtotal></span>
        </div>
        <a href="{{ routes.cart_url }}" class="btn btn--outline btn--full">View Cart</a>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--gold btn--full">Checkout</button>
        </form>
      </div>
    </aside>

    <div class="toast" data-toast hidden role="status" aria-live="polite"></div>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
